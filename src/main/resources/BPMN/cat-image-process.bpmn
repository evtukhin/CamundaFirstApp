  <bpmn:process id="CatImageProcess" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Recieve email">
      <bpmn:documentation>Start process with email input</bpmn:documentation>
      <bpmn:outgoing>Flow_1mtsqtp</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_1mtsqtp" sourceRef="StartEvent_1" targetRef="ServiceTask_ValidateEmail" />
    <bpmn:serviceTask id="ServiceTask_ValidateEmail" name="Validate email" camunda:class="ru.absolutins.camundaFirstApp.delegate.EmailValidationDelegate">
      <bpmn:documentation>Check if email is valid</bpmn:documentation>
      <bpmn:incoming>Flow_1mtsqtp</bpmn:incoming>
      <bpmn:outgoing>Flow_12cqyv4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="Gateway_14jjk2w">
      <bpmn:extensionElements />
      <bpmn:incoming>Flow_12cqyv4</bpmn:incoming>
      <bpmn:outgoing>Flow_1j0blnt</bpmn:outgoing>
      <bpmn:outgoing>Flow_0057ix7</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="Flow_1j0blnt" sourceRef="Gateway_14jjk2w" targetRef="ServiceTask_GetCatFact" />
    <bpmn:sequenceFlow id="Flow_0057ix7" sourceRef="Gateway_14jjk2w" targetRef="ServiceTask_GetCatImage" />
