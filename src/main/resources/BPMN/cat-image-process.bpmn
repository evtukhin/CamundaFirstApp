    <bpmn:serviceTask id="ServiceTask_GetCatFact" name="Get cat fact" camunda:class="ru.absolutins.camundaFirstApp.delegate.CatFactDelegate">
      <bpmn:documentation>Fetch random fact about cats</bpmn:documentation>
      <bpmn:extensionElements />
      <bpmn:incoming>Flow_1j0blnt</bpmn:incoming>
      <bpmn:outgoing>Flow_12nenru</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask_GetCatImage" name="Get cat image" camunda:class="ru.absolutins.camundaFirstApp.delegate.CatImageDelegate">
      <bpmn:documentation>Fetch random cat image</bpmn:documentation>
      <bpmn:incoming>Flow_0057ix7</bpmn:incoming>
      <bpmn:outgoing>Flow_1264ry6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="Gateway_0e826mr">
      <bpmn:incoming>Flow_12nenru</bpmn:incoming>
      <bpmn:incoming>Flow_1264ry6</bpmn:incoming>
      <bpmn:outgoing>Flow_19swzl0</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="Flow_12nenru" sourceRef="ServiceTask_GetCatFact" targetRef="Gateway_0e826mr" />
    <bpmn:sequenceFlow id="Flow_1264ry6" sourceRef="ServiceTask_GetCatImage" targetRef="Gateway_0e826mr" />
    <bpmn:sequenceFlow id="Flow_19swzl0" sourceRef="Gateway_0e826mr" targetRef="ServiceTask_ProcessImage" />
    <bpmn:serviceTask id="ServiceTask_ProcessImage" name="Process image" camunda:class="ru.absolutins.camundaFirstApp.delegate.ImageProcessingDelegate">
      <bpmn:documentation>Overlay text on image</bpmn:documentation>
      <bpmn:incoming>Flow_19swzl0</bpmn:incoming>
      <bpmn:outgoing>Flow_1kfe390</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1kfe390" sourceRef="ServiceTask_ProcessImage" targetRef="ServiceTask_SendEmail" />
    <bpmn:serviceTask id="ServiceTask_SendEmail" name="Send email" camunda:class="ru.absolutins.camundaFirstApp.delegate.EmailSenderDelegate">
      <bpmn:documentation>Send processed image via email</bpmn:documentation>
      <bpmn:incoming>Flow_1kfe390</bpmn:incoming>
      <bpmn:outgoing>Flow_1a878i9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_1" name="Process completed">
      <bpmn:incoming>Flow_1a878i9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1a878i9" sourceRef="ServiceTask_SendEmail" targetRef="EndEvent_1" />
  </bpmn:process>
